# Claude Code
.claude/

# Build output
bin/
obj/

# Visual Studio
.vs/
*.user
*.suo

# App settings with secrets — use appsettings.Sample.json as a template
appsettings.json
appsettings.*.json
!appsettings.Sample.json

# Runtime state files are written to a "state" folder next to the built exe (under bin/ or the
# publish folder), so no pattern is needed here. Don't add "state/": Git on Windows ignores case,
# so it also matched the Watchdog/State/ source folder and kept it out of the repo.

# Logs
logs/
*.log
